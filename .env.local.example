# Environment Variables for Sketch Museum Portfolio

# Development settings
NODE_ENV=development

# Bundle analyzer (set to 'true' to enable)
ANALYZE=false

# Image optimization settings
NEXT_IMAGE_DOMAINS=localhost

# Performance monitoring (optional)
# NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id

# Contact form settings (if needed later)
# CONTACT_EMAIL=your_email@example.com
# INSTAGRAM_URL=https://instagram.com/your_handle
# WHATSAPP_URL=https://wa.me/your_number