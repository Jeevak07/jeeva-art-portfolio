# dotenv environment variables file
.env.test

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# Temporary files
.tmp/
.temp/

# Portfolio specific ignores
# Ignore any sensitive artwork files (if any)
/public/images/private/
/src/assets/private/

# Ignore any local configuration files
config.local.js
config.local.json

# Ignore any backup files
*.backup
*.bak
*.orig

# Ignore any generated documentation
/docs/generated/

# Ignore any local database files
*.db
*.sqlite
*.sqlite3

# Ignore any local uploads (if implementing file upload)
/uploads/
/public/uploads/

# Ignore any analytics or tracking files
analytics.json
tracking.json

# Ignore any local development files
dev-notes.md
